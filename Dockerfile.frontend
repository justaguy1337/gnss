# ─────────────────────────────────────────────
# GNSS ErrorNet — Frontend (React)
# ─────────────────────────────────────────────

# === Stage 1: Build ===
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY public/ ./public/
COPY src/ ./src/

# The React app talks to the backend via the nginx reverse-proxy
# so API calls go to /api/* on the same origin (no CORS issues).
ENV REACT_APP_API_URL=/api

RUN npm run build

# === Stage 2: Serve with nginx ===
FROM nginx:alpine

# Custom nginx config with reverse-proxy to backend
COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
